# Project URL from Supabase → Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key from the same page (new projects).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Older projects show an anon key instead. The app accepts either name.
# Leave the publishable key empty and set this one, or the other way around.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional, local only. Opens /anteprima with fake hotels so the interface
# can be reviewed without a Supabase project. It never reads a database.
# Do not enable this on Vercel.
# ENABLE_UI_PREVIEW=1
